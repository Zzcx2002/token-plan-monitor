---
import type { IconName } from '../content/types';

export type Name = IconName | 'download' | 'github' | 'apple' | 'windows' | 'arrow' | 'check' | 'refresh' | 'info';
interface Props { name: Name; size?: number; strokeWidth?: number; class?: string }
const { name, size = 20, strokeWidth = 1.7, class: className = '' } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'gauge' && <><path d="M4 14a8 8 0 1 1 16 0"/><path d="m12 14 4-4"/><path d="M4 19h16"/></>}
  {name === 'bell' && <><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></>}
  {name === 'code' && <><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></>}
  {name === 'shield' && <><path d="M12 3 4.5 6v5c0 4.8 3.2 8.2 7.5 10 4.3-1.8 7.5-5.2 7.5-10V6Z"/><path d="m9 12 2 2 4-4"/></>}
  {name === 'database' && <><ellipse cx="12" cy="5" rx="7.5" ry="3"/><path d="M4.5 5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V5"/><path d="M4.5 11v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6"/></>}
  {name === 'key' && <><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8"/><path d="m15 8 3 3"/><path d="m17 6 2 2"/></>}
  {name === 'download' && <><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></>}
  {name === 'arrow' && <><path d="M7 17 17 7"/><path d="M7 7h10v10"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'refresh' && <><path d="M20 7v5h-5"/><path d="M4 17v-5h5"/><path d="M6.1 8a7 7 0 0 1 11.4-2.1L20 8"/><path d="M4 16l2.5 2.1A7 7 0 0 0 17.9 16"/></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></>}
  {name === 'github' && <><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.1-1.3-.3-2.5-1-3.5.3-1.2.3-2.4 0-3.5 0 0-1 0-3 1.5a12.3 12.3 0 0 0-8 0C6 2 5 2 5 2c-.3 1.1-.3 2.3 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5a4.8 4.8 0 0 0-1 3.5v4"/><path d="M9 18c-4.5 2-5-2-7-2"/></>}
  {name === 'apple' && <><path d="M12 20.9c1.5 0 2.8 1.1 4 1.1 3 0 6-8.1 6-12.2A4.9 4.9 0 0 0 17 5c-2.2 0-4 1.4-5 2-1-.6-2.8-2-5-2a4.9 4.9 0 0 0-5 4.8C2 14 5 22 8 22c1.3 0 2.5-1.1 4-1.1Z"/><path d="M10 2c1 .5 2 2 2 5"/></>}
  {name === 'windows' && <><path d="M3 5.4 10.5 4.3v7.2H3Z" fill="currentColor" stroke="none"/><path d="M12 4.1 21 3v8.5h-9Z" fill="currentColor" stroke="none"/><path d="M3 13h7.5v7.2L3 19.1Z" fill="currentColor" stroke="none"/><path d="M12 13h9V21l-9-1.2Z" fill="currentColor" stroke="none"/></>}
</svg>
